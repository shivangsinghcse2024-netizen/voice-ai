# Comma-separated API keys. Each must be 32+ characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEYS=PASTE_GENERATED_KEY_HERE

# Hosts allowed in the Host header (comma-separated). Add your domain in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# Browser origins allowed to call the API from another site. Leave empty = same-origin only.
ALLOWED_ORIGINS=

# tiny | base | small | medium | large  (bigger = more accurate, slower, more RAM)
WHISPER_MODEL=base

MAX_UPLOAD_MB=25
MAX_AUDIO_SECONDS=300
RATE_LIMIT=10/minute
MAX_CONCURRENT_JOBS=2

# Voice-tone emotion (wav2vec2). Set false to save memory.
ENABLE_AUDIO_EMOTION=true

# Swagger UI at /docs. Keep false in production.
ENABLE_DOCS=false
